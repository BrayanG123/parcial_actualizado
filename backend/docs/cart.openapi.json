{
  "openapi": "3.0.3",
  "info": {
    "title": "FashionStore — Carrito",
    "version": "1.0.0",
    "description": "Un carrito ACTIVE por cliente. JWT y CUSTOMER obligatorios. No reserva ni descuenta stock. Los importes son actuales e informativos; el checkout requiere una nueva validación."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/cart": {
      "get": {
        "summary": "Consultar el carrito activo propio",
        "description": "Crea un carrito vacío si no existe. Devuelve precios y disponibilidad vigentes, conservando storedUnitPrice.",
        "responses": {
          "200": {
            "description": "Carrito completo actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "timestamp"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Cart"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Se requiere un cliente activo con rol CUSTOMER",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Producto o línea no encontrado en el carrito activo propio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Producto/variante inactivo, stock insuficiente o conflicto concurrente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cart/items": {
      "post": {
        "summary": "Agregar variante o incrementar su cantidad",
        "description": "Máximo 50 variantes y 100 unidades acumuladas por variante. Requiere stock suficiente en al menos una sucursal activa. No acepta precio ni identidad del carrito.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddItem"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Carrito completo actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "timestamp"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Cart"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Se requiere un cliente activo con rol CUSTOMER",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Producto o línea no encontrado en el carrito activo propio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Producto/variante inactivo, stock insuficiente o conflicto concurrente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Vaciar el carrito activo propio",
        "description": "Conserva el carrito ACTIVE; no altera stock.",
        "responses": {
          "200": {
            "description": "Carrito completo actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "timestamp"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Cart"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Se requiere un cliente activo con rol CUSTOMER",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Producto o línea no encontrado en el carrito activo propio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Producto/variante inactivo, stock insuficiente o conflicto concurrente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cart/items/{itemId}": {
      "patch": {
        "summary": "Reemplazar cantidad de una línea propia",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Carrito completo actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "timestamp"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Cart"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Se requiere un cliente activo con rol CUSTOMER",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Producto o línea no encontrado en el carrito activo propio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Producto/variante inactivo, stock insuficiente o conflicto concurrente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Eliminar una línea del carrito activo propio",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Carrito completo actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "timestamp"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Cart"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Se requiere un cliente activo con rol CUSTOMER",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Producto o línea no encontrado en el carrito activo propio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Producto/variante inactivo, stock insuficiente o conflicto concurrente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AddItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "sizeId", "colorId", "quantity"],
        "properties": {
          "productId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "sizeId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "colorId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "UpdateItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quantity"],
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "Cart": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          },
          "itemCount": {
            "type": "integer",
            "minimum": 0
          },
          "totalQuantity": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "number",
            "description": "Suma decimal de subtotales a precio vigente, incluso artículos no disponibles"
          },
          "availableBranches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "name": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                }
              }
            }
          },
          "hasAvailability": {
            "type": "boolean",
            "description": "Existe una sucursal activa con stock para todas las líneas; falso para el carrito vacío"
          }
        }
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "productId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "sizeId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "colorId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "product": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "name": {
                "type": "string"
              },
              "imageUrl": {
                "type": "string",
                "nullable": true
              },
              "active": {
                "type": "boolean"
              }
            }
          },
          "size": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "name": {
                "type": "string"
              }
            }
          },
          "color": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "name": {
                "type": "string"
              },
              "hexCode": {
                "type": "string"
              }
            }
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "unitPrice": {
            "type": "number",
            "description": "Precio actual del catálogo, con promoción vigente"
          },
          "storedUnitPrice": {
            "type": "number",
            "description": "Precio guardado al agregar o modificar la línea"
          },
          "priceChanged": {
            "type": "boolean"
          },
          "promotionActive": {
            "type": "boolean"
          },
          "subtotal": {
            "type": "number"
          },
          "available": {
            "type": "boolean"
          },
          "availability": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "branch": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    },
                    "name": {
                      "type": "string"
                    },
                    "city": {
                      "type": "string"
                    }
                  }
                },
                "availableQuantity": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "issue": {
            "type": "string",
            "nullable": true,
            "enum": [
              "PRODUCT_INACTIVE",
              "VARIANT_UNAVAILABLE",
              "INSUFFICIENT_STOCK",
              null
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [false]
          },
          "statusCode": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "path": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
