NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tienda_ropa?schema=public
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

JWT_SECRET=replace-with-a-secure-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
PASSWORD_SALT_ROUNDS=12
RESERVATION_TIME_ZONE=America/La_Paz
CHECKOUT_HOLD_MINUTES=15
SALES_CURRENCY=BOB
# Optional: configure all three to enable Stripe (academic test mode only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Optional: configure all three to upload product photos. Backend only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# IA: gemini (API externa) | ollama (IA local) | none (solo reglas, sin modelo).
# Si falta la clave o el proveedor falla, asistente/recomendaciones/reportes usan reglas.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Probador con IA (foto de la persona + prenda). Requiere facturacion activa en Google AI Studio:
# la capa gratuita tiene cuota 0 para modelos de imagen y el endpoint responde 503.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
AI_IMAGE_TIMEOUT_MS=90000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
AI_TIMEOUT_MS=20000
AI_REQUESTS_PER_MINUTE=20
# Notificaciones push (Firebase > Configuracion del proyecto > Cuentas de servicio >
# Generar nueva clave privada). Copiar project_id, client_email y private_key del JSON.
# La clave va entre comillas y con los saltos de linea como 
. Sin ellas, push queda desactivado.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SEED_ADMIN_EMAIL=admin@fashionstore.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123!
SEED_DEMO_PASSWORD=ChangeThisDemoPassword123!
# Optional fixed reference date for demo history (default: today in Bolivia).
# SEED_DEMO_DATE=2026-09-12
# Optional fixed reference date for the massive Bolivia fixture.
# SEED_MASSIVE_DATE=2026-09-12

# Optional demo seeds: npm run prisma:seed:reservations / npm run prisma:seed:cart
SEED_CUSTOMER_EMAIL=cliente.demo@fashionstore.com
SEED_CUSTOMER_PASSWORD=ChangeThisCustomerPassword123!
