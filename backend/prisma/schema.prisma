generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMINISTRATOR
  BRANCH_MANAGER
  CASHIER
  CUSTOMER
  SUPPLIER
}

enum InventoryMovementType {
  ENTRY
  SALE
  RESERVATION
  RESERVATION_RELEASE
  RETURN
  ADJUSTMENT
  PENDING_ENTRY
  CHECKOUT_HOLD
  CHECKOUT_RELEASE
}

enum InventoryMovementStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  PREPARING
  READY
  CUSTOMER_PRESENT
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ReservationItemStatus {
  PENDING
  PREPARED
  PURCHASED
  RETURNED
  UNAVAILABLE
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum SaleChannel {
  IN_STORE
  WEB
  MOBILE
}

enum SaleStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  QR
  BANK_TRANSFER
  GATEWAY
}

enum PaymentType {
  IN_STORE
  ELECTRONIC
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
  REFUNDED
}

model User {
  supplierId Int? @map("id_proveedor")
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  id           Int        @id @default(autoincrement()) @map("id_usuario")
  name         String     @map("nombre") @db.VarChar(120)
  email        String     @unique @db.VarChar(180)
  passwordHash String     @map("password_hash")
  active       Boolean    @default(true) @map("activo")
  registeredAt DateTime   @default(now()) @map("fecha_registro") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  client       Client?
  employee     Employee?
  roles        UserRole[]
  createdSales Sale[] @relation("SaleCreator")
  cashShifts CashShift[]
  notificationReads NotificationRead[]
  pushTokens PushToken[]

  @@index([supplierId])
  @@map("usuarios")
}

model Client {
  wholesale       Boolean            @default(false) @map("mayorista")
  id              Int                @id @default(autoincrement()) @map("id_cliente")
  userId          Int                @unique @map("id_usuario")
  phone           String?            @map("telefono") @db.VarChar(30)
  address         String?            @map("direccion") @db.VarChar(250)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations    Reservation[]
  carts           Cart[]
  sales           Sale[]
  recommendations AiRecommendation[]

  @@map("clientes")
}

model Employee {
  id                 Int                 @id @default(autoincrement()) @map("id_empleado")
  userId             Int                 @unique @map("id_usuario")
  branchId           Int                 @map("id_sucursal")
  jobTitle           String              @map("cargo") @db.VarChar(80)
  active             Boolean             @default(true) @map("activo")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]
  sales              Sale[]

  @@index([branchId])
  @@map("empleados")
}

model Role {
  id          Int        @id @default(autoincrement()) @map("id_rol")
  name        RoleName   @unique @map("nombre")
  description String?    @map("descripcion") @db.VarChar(250)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     Int      @map("id_usuario")
  roleId     Int      @map("id_rol")
  assignedAt DateTime @default(now()) @map("fecha_asignacion") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("usuarios_roles")
}

model Branch {
  /// MVP: un solo almacen por sucursal; comparte su identificador y existencias.
  warehouseName String        @default("Almacen principal") @map("nombre_almacen") @db.VarChar(120)
  id           Int           @id @default(autoincrement()) @map("id_sucursal")
  name         String        @map("nombre") @db.VarChar(120)
  city         String        @map("ciudad") @db.VarChar(100)
  address      String        @map("direccion") @db.VarChar(250)
  phone        String?       @map("telefono") @db.VarChar(30)
  active       Boolean       @default(true) @map("activa")
  employees    Employee[]
  inventory    Inventory[]
  reservations Reservation[]
  sales        Sale[]
  notifications Notification[]
  cashRegisters CashRegister[]

  @@unique([city, name])
  @@index([city, active])
  @@map("sucursales")
}

model Category {
  id          Int       @id @default(autoincrement()) @map("id_categoria")
  name        String    @unique @map("nombre") @db.VarChar(100)
  description String?   @map("descripcion") @db.VarChar(250)
  products    Product[]

  @@map("categorias")
}

model Season {
  id          Int          @id @default(autoincrement()) @map("id_temporada")
  name        String       @unique @map("nombre") @db.VarChar(120)
  startDate   DateTime     @map("fecha_inicio") @db.Date
  endDate     DateTime     @map("fecha_fin") @db.Date
  active      Boolean      @default(true) @map("activa")
  collections Collection[]
  products    Product[]

  @@index([active, startDate, endDate])
  @@map("temporadas")
}

model Collection {
  id          Int       @id @default(autoincrement()) @map("id_coleccion")
  seasonId    Int       @map("id_temporada")
  name        String    @map("nombre") @db.VarChar(120)
  description String?   @map("descripcion") @db.VarChar(250)
  active      Boolean   @default(true) @map("activa")
  season      Season    @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([seasonId, name])
  @@index([active])
  @@map("colecciones")
}

model Supplier {
  accounts User[]
  id       Int       @id @default(autoincrement()) @map("id_proveedor")
  name     String    @unique @map("nombre") @db.VarChar(150)
  contact  String?   @map("contacto") @db.VarChar(120)
  phone    String?   @map("telefono") @db.VarChar(30)
  email    String?   @db.VarChar(180)
  active   Boolean   @default(true) @map("activo")
  products Product[]

  @@map("proveedores")
}

model Size {
  id               Int               @id @default(autoincrement()) @map("id_talla")
  name             String            @unique @map("nombre") @db.VarChar(30)
  products         ProductSize[]
  inventory        Inventory[]
  reservationItems ReservationItem[]
  cartItems        CartItem[]
  saleItems        SaleItem[]

  @@map("tallas")
}

model Color {
  id               Int               @id @default(autoincrement()) @map("id_color")
  name             String            @unique @map("nombre") @db.VarChar(60)
  hexCode          String            @unique @map("codigo_hex") @db.VarChar(7)
  products         ProductColor[]
  inventory        Inventory[]
  reservationItems ReservationItem[]
  cartItems        CartItem[]
  saleItems        SaleItem[]

  @@map("colores")
}

model Product {
  supplierAvailability String? @map("disponibilidad_proveedor") @db.VarChar(500)
  wholesalePrice   Decimal?           @map("precio_mayorista") @db.Decimal(12, 2)
  imageUrls        String[]           @default([]) @map("imagenes")
  id               Int                @id @default(autoincrement()) @map("id_producto")
  categoryId       Int                @map("id_categoria")
  seasonId         Int                @map("id_temporada")
  collectionId     Int                @map("id_coleccion")
  supplierId       Int                @map("id_proveedor")
  name             String             @map("nombre") @db.VarChar(160)
  description      String?            @map("descripcion") @db.Text
  price            Decimal            @map("precio") @db.Decimal(12, 2)
  imageUrl         String?            @map("imagen_url") @db.Text
  discountPercent  Decimal            @default(0) @map("descuento_pct") @db.Decimal(5, 2)
  promotionStart   DateTime?          @map("promo_inicio") @db.Date
  promotionEnd     DateTime?          @map("promo_fin") @db.Date
  active           Boolean            @default(true) @map("activo")
  createdAt        DateTime           @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  category         Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  season           Season             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  collection       Collection         @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  supplier         Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sizes            ProductSize[]
  colors           ProductColor[]
  inventory        Inventory[]
  reservationItems ReservationItem[]
  cartItems        CartItem[]
  saleItems        SaleItem[]
  arResources      ArResource[]
  recommendations  AiRecommendation[]

  @@unique([supplierId, name])
  @@index([categoryId, active])
  @@index([seasonId, collectionId])
  @@index([supplierId])
  @@index([name])
  @@map("productos")
}

model ProductSize {
  productId Int     @map("id_producto")
  sizeId    Int     @map("id_talla")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      Size    @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@id([productId, sizeId])
  @@index([sizeId])
  @@map("productos_tallas")
}

model ProductColor {
  productId Int     @map("id_producto")
  colorId   Int     @map("id_color")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@id([productId, colorId])
  @@index([colorId])
  @@map("productos_colores")
}

model Inventory {
  id               Int                 @id @default(autoincrement()) @map("id_inventario")
  branchId         Int                 @map("id_sucursal")
  productId        Int                 @map("id_producto")
  sizeId           Int                 @map("id_talla")
  colorId          Int                 @map("id_color")
  physicalQuantity Int                 @default(0) @map("cantidad_fisica")
  reservedQuantity Int                 @default(0) @map("cantidad_reservada")
  updatedAt        DateTime            @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  size             Size                @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  color            Color               @relation(fields: [colorId], references: [id], onDelete: Restrict)
  movements        InventoryMovement[]

  @@unique([branchId, productId, sizeId, colorId])
  @@index([productId, sizeId, colorId])
  @@map("inventarios")
}

model InventoryMovement {
  id          Int                     @id @default(autoincrement()) @map("id_movimiento")
  inventoryId Int                     @map("id_inventario")
  employeeId  Int?                    @map("id_empleado")
  type        InventoryMovementType   @map("tipo")
  quantity    Int                     @map("cantidad")
  status      InventoryMovementStatus @default(COMPLETED) @map("estado")
  reference   String?                 @map("referencia") @db.VarChar(150)
  occurredAt  DateTime                @default(now()) @map("fecha") @db.Timestamptz(3)
  scheduledAt DateTime?               @map("fecha_programada") @db.Timestamptz(3)
  observation String?                 @map("observacion") @db.VarChar(500)
  inventory   Inventory               @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  employee    Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([inventoryId, occurredAt])
  @@index([employeeId])
  @@index([type, status])
  @@map("movimientos_inventario")
}

model Reservation {
  id              Int               @id @default(autoincrement()) @map("id_reserva")
  clientId        Int               @map("id_cliente")
  branchId        Int               @map("id_sucursal")
  reservedAt      DateTime          @default(now()) @map("fecha_reserva") @db.Timestamptz(3)
  approximateTime DateTime          @map("horario_aproximado") @db.Timestamptz(3)
  expiresAt       DateTime          @map("fecha_vencimiento") @db.Timestamptz(3)
  status          ReservationStatus @default(PENDING) @map("estado")
  observation     String?           @map("observacion") @db.VarChar(500)
  updatedAt       DateTime          @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items           ReservationItem[]
  sale            Sale?
  notification    Notification?

  @@index([clientId, status])
  @@index([branchId, approximateTime, status])
  @@index([status, expiresAt])
  @@map("reservas")
}

model ReservationItem {
  id            Int                   @id @default(autoincrement()) @map("id_detalle_reserva")
  reservationId Int                   @map("id_reserva")
  productId     Int                   @map("id_producto")
  sizeId        Int                   @map("id_talla")
  colorId       Int                   @map("id_color")
  quantity      Int                   @map("cantidad")
  purchasedQuantity Int @default(0) @map("cantidad_comprada")
  status        ReservationItemStatus @default(PENDING) @map("estado")
  reservation   Reservation           @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  size          Size                  @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  color         Color                 @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@unique([reservationId, productId, sizeId, colorId])
  @@index([productId, sizeId, colorId])
  @@map("detalles_reserva")
}

model Cart {
  // One ACTIVE cart per client is enforced by a partial unique index in migration
  // 20260912010000_active_cart_unique; historical carts remain unrestricted.
  id        Int        @id @default(autoincrement()) @map("id_carrito")
  clientId  Int        @map("id_cliente")
  createdAt DateTime   @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  status    CartStatus @default(ACTIVE) @map("estado")
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items     CartItem[]
  sale      Sale?

  @@index([clientId, status])
  @@map("carritos")
}

model CartItem {
  id        Int     @id @default(autoincrement()) @map("id_detalle_carrito")
  cartId    Int     @map("id_carrito")
  productId Int     @map("id_producto")
  sizeId    Int     @map("id_talla")
  colorId   Int     @map("id_color")
  quantity  Int     @map("cantidad")
  unitPrice Decimal @map("precio_unitario") @db.Decimal(12, 2)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  size      Size    @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId, sizeId, colorId])
  @@index([productId, sizeId, colorId])
  @@map("detalles_carrito")
}

model CashRegister {
  id Int @id @default(autoincrement()) @map("id_caja")
  branchId Int @map("id_sucursal")
  name String @map("nombre") @db.VarChar(80)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shifts CashShift[]
  @@unique([branchId, name])
  @@map("cajas")
}

model CashShift {
  // Partial unique indexes enforce one open shift per user and register.
  id Int @id @default(autoincrement()) @map("id_turno")
  registerId Int @map("id_caja")
  userId Int @map("id_usuario")
  openingKey String @map("clave_apertura") @db.Uuid
  openedAt DateTime @default(now()) @map("fecha_apertura") @db.Timestamptz(3)
  closedAt DateTime? @map("fecha_cierre") @db.Timestamptz(3)
  currency String @map("moneda") @db.VarChar(3)
  openingCash Decimal @map("saldo_inicial") @db.Decimal(14, 2)
  cashTotal Decimal @default(0) @map("ventas_efectivo") @db.Decimal(14, 2)
  cardTotal Decimal @default(0) @map("ventas_tarjeta") @db.Decimal(14, 2)
  qrTotal Decimal @default(0) @map("ventas_qr") @db.Decimal(14, 2)
  transferTotal Decimal @default(0) @map("ventas_transferencia") @db.Decimal(14, 2)
  saleCount Int @default(0) @map("cantidad_ventas")
  countedCash Decimal? @map("efectivo_contado") @db.Decimal(14, 2)
  closingNote String? @map("observacion_cierre") @db.VarChar(500)
  register CashRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  sales Sale[]
  offlineBatches OfflineBatch[]
  @@unique([userId, openingKey])
  @@index([registerId, openedAt])
  @@index([userId, openedAt])
  @@map("turnos_caja")
}

model OfflineBatch {
  id String @id @db.Uuid
  shiftId Int @map("id_turno")
  deviceId String @map("id_dispositivo") @db.Uuid
  preparedAt DateTime @default(now()) @map("fecha_preparacion") @db.Timestamptz(3)
  finishedAt DateTime? @map("fecha_finalizacion") @db.Timestamptz(3)
  snapshot Json @map("catalogo")
  revision Int @default(0)
  shift CashShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  sales Sale[]
  @@index([shiftId])
  @@map("lotes_offline")
}

model Sale {
  cashOnDelivery Boolean @default(false) @map("contra_entrega")
  deliveryName String? @map("destinatario") @db.VarChar(120)
  deliveryPhone String? @map("telefono_entrega") @db.VarChar(30)
  deliveryAddress String? @map("direccion_entrega") @db.VarChar(250)
  deliveredAt DateTime? @map("fecha_entrega") @db.Timestamptz(3)
  offlineBatchId String? @map("id_lote_offline") @db.Uuid
  offlineBatch OfflineBatch? @relation(fields: [offlineBatchId], references: [id], onDelete: Restrict)
  shiftId Int? @map("id_turno")
  shift CashShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  id            Int          @id @default(autoincrement()) @map("id_venta")
  clientId      Int?         @map("id_cliente")
  employeeId    Int?         @map("id_empleado")
  branchId      Int?         @map("id_sucursal")
  reservationId Int?         @unique @map("id_reserva")
  cartId        Int?         @unique @map("id_carrito")
  createdById   Int?         @map("id_usuario_creador")
  idempotencyKey String?     @map("clave_idempotencia") @db.Uuid
  requestHash   String?      @map("hash_solicitud") @db.VarChar(64)
  currency      String       @default("BOB") @map("moneda") @db.VarChar(3)
  stockReserved Boolean     @default(false) @map("stock_apartado")
  expiresAt     DateTime?    @map("fecha_vencimiento") @db.Timestamptz(3)
  confirmedAt   DateTime?    @map("fecha_confirmacion") @db.Timestamptz(3)
  cancellationReason String? @map("motivo_cancelacion") @db.VarChar(100)
  soldAt        DateTime     @default(now()) @map("fecha") @db.Timestamptz(3)
  channel       SaleChannel  @map("canal")
  status        SaleStatus   @default(DRAFT) @map("estado")
  total         Decimal      @db.Decimal(12, 2)
  updatedAt     DateTime     @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  employee      Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  branch        Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  cart          Cart?        @relation(fields: [cartId], references: [id], onDelete: SetNull)
  createdBy     User?        @relation("SaleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items         SaleItem[]
  payments      Payment[]

  @@index([offlineBatchId])
  @@index([shiftId])
  @@index([clientId, soldAt])
  @@index([employeeId])
  @@index([branchId, soldAt])
  @@index([channel, status])
  @@unique([createdById, idempotencyKey])
  @@index([status, expiresAt])
  @@map("ventas")
}

model SaleItem {
  id        Int     @id @default(autoincrement()) @map("id_detalle_venta")
  saleId    Int     @map("id_venta")
  productId Int     @map("id_producto")
  sizeId    Int     @map("id_talla")
  colorId   Int     @map("id_color")
  quantity  Int     @map("cantidad")
  unitPrice Decimal @map("precio_unitario") @db.Decimal(12, 2)
  discount  Decimal @default(0) @map("descuento") @db.Decimal(12, 2)
  productName String? @map("nombre_producto") @db.VarChar(160)
  sizeName String? @map("nombre_talla") @db.VarChar(30)
  colorName String? @map("nombre_color") @db.VarChar(60)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  size      Size    @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId, sizeId, colorId])
  @@map("detalles_venta")
}

model Payment {
  id                Int           @id @default(autoincrement()) @map("id_pago")
  saleId            Int           @map("id_venta")
  method            PaymentMethod @map("metodo")
  type              PaymentType   @map("tipo")
  amount            Decimal       @map("monto") @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING) @map("estado")
  externalReference String?       @unique @map("referencia_externa") @db.VarChar(200)
  stripeRequestKey  String        @unique @default(uuid()) @map("stripe_request_key") @db.Uuid
  stripeIntentId    String?       @unique @map("stripe_intent_id") @db.VarChar(200)
  stripeStatus      String?       @map("stripe_status") @db.VarChar(40)
  stripeRefundId    String?       @unique @map("stripe_refund_id") @db.VarChar(200)
  stripeRefundStatus String?      @map("stripe_refund_status") @db.VarChar(40)
  refundRequestedAt DateTime?     @map("reembolso_solicitado_en") @db.Timestamptz(3)
  lastStripeSyncAt  DateTime?     @map("stripe_sincronizado_en") @db.Timestamptz(3)
  paidAt            DateTime      @default(now()) @map("fecha") @db.Timestamptz(3)
  sale              Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([saleId, status])
  @@index([status, lastStripeSyncAt])
  @@map("pagos")
}

model ArResource {
  id        Int     @id @default(autoincrement()) @map("id_recurso_ra")
  productId Int     @map("id_producto")
  type      String  @map("tipo") @db.VarChar(50)
  url       String  @map("url_recurso") @db.Text
  format    String  @map("formato") @db.VarChar(30)
  active    Boolean @default(true) @map("activo")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, active])
  @@map("recursos_ra")
}

model AiRecommendation {
  id        Int      @id @default(autoincrement()) @map("id_recomendacion")
  clientId  Int      @map("id_cliente")
  productId Int      @map("id_producto")
  createdAt DateTime @default(now()) @map("fecha") @db.Timestamptz(3)
  reason    String?  @map("motivo") @db.VarChar(500)
  score     Decimal  @map("puntuacion") @db.Decimal(5, 4)
  source    String   @map("origen") @db.VarChar(100)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([productId])
  @@map("recomendaciones_ia")
}

// One branch-wide event per reservation; read state belongs to each staff user.
model Notification {
  id              Int       @id @default(autoincrement()) @map("id_notificacion")
  branchId        Int       @map("id_sucursal")
  reservationId   Int       @unique @map("id_reserva")
  unitCount       Int       @map("cantidad_prendas")
  approximateTime DateTime  @map("horario_aproximado") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reads           NotificationRead[]

  @@index([branchId, createdAt, id])
  @@index([createdAt, id])
  @@map("notificaciones")
}

// Dispositivos del personal que reciben notificaciones push (Firebase Cloud Messaging).
model PushToken {
  id        Int      @id @default(autoincrement()) @map("id_token_push")
  userId    Int      @map("id_usuario")
  token     String   @unique
  platform  String   @default("WEB") @map("plataforma") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tokens_push")
}

model NotificationRead {
  notificationId Int          @map("id_notificacion")
  userId         Int          @map("id_usuario")
  readAt         DateTime     @default(now()) @map("fecha_lectura") @db.Timestamptz(3)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, notificationId])
  @@map("lecturas_notificacion")
}
