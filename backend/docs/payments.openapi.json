{
  "openapi": "3.0.3",
  "info": {
    "title": "FashionStore — Pagos/Stripe",
    "version": "1.0.0",
    "description": "Payment Intents de tarjeta en modo prueba. Importe calculado desde la venta; eventos verificados y reconciliados contra Stripe. Reembolso automático de cobros de pedidos cancelados/vencidos."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/payments/stripe/config": {
      "get": {
        "operationId": "stripeConfig",
        "summary": "Configuración pública para cliente autenticado",
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/StripeConfig"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Datos o firma inválidos; operación rechazada por Stripe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permisos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Venta/pago inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Pedido vencido, estado o datos del proveedor incompatibles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Stripe no configurado o temporalmente indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/payments/stripe/intents": {
      "post": {
        "operationId": "createStripeIntent",
        "summary": "Crear/reutilizar Payment Intent de una venta pendiente propia",
        "description": "Idempotencia automática por pago. Solo rol CUSTOMER propietario. No acepta importes, monedas, tarjetas ni referencias arbitrarias. Cache-Control: no-store.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIntent"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Intent"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Datos o firma inválidos; operación rechazada por Stripe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permisos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Venta/pago inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Pedido vencido, estado o datos del proveedor incompatibles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Stripe no configurado o temporalmente indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/payments/sales/{saleId}": {
      "get": {
        "operationId": "paymentStatus",
        "summary": "Estado local del pago; propietario o personal autorizado de la sucursal",
        "parameters": [
          {
            "name": "saleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/PaymentStatus"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Datos o firma inválidos; operación rechazada por Stripe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permisos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Venta/pago inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Pedido vencido, estado o datos del proveedor incompatibles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Stripe no configurado o temporalmente indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/payments/stripe/webhook": {
      "post": {
        "operationId": "stripeWebhook",
        "summary": "Recibir eventos de Stripe con firma del cuerpo original",
        "security": [],
        "parameters": [
          {
            "name": "Stripe-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Evento Stripe sin modificar. Solo test mode; debe tener una firma auténtica reciente."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/WebhookResult"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Datos o firma inválidos; operación rechazada por Stripe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permisos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Venta/pago inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Pedido vencido, estado o datos del proveedor incompatibles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Stripe no configurado o temporalmente indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreateIntent": {
        "type": "object",
        "properties": {
          "saleId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "saleId"
        ]
      },
      "StripeConfig": {
        "type": "object",
        "properties": {
          "publishableKey": {
            "type": "string",
            "example": "pk_test_..."
          },
          "mode": {
            "type": "string",
            "enum": [
              "test"
            ]
          },
          "currencies": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "BOB",
                "USD",
                "EUR"
              ]
            }
          }
        },
        "required": [
          "publishableKey",
          "mode",
          "currencies"
        ]
      },
      "Intent": {
        "type": "object",
        "properties": {
          "saleId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "paymentId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "paymentIntentId": {
            "type": "string"
          },
          "clientSecret": {
            "type": "string",
            "nullable": true,
            "description": "Solo para el propietario; no persistir ni incluir en logs/URLs. Null si el pedido ya terminó."
          },
          "publishableKey": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "stripeStatus": {
            "type": "string",
            "nullable": true
          },
          "amount": {
            "type": "number",
            "description": "Importe en unidades monetarias, no centavos."
          },
          "currency": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "saleId",
          "paymentId",
          "clientSecret",
          "status",
          "stripeStatus"
        ]
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "saleId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "method": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED",
              "VOIDED",
              "REFUNDED"
            ]
          },
          "externalReference": {
            "type": "string",
            "nullable": true
          },
          "stripeIntentId": {
            "type": "string",
            "nullable": true
          },
          "stripeStatus": {
            "type": "string",
            "nullable": true
          },
          "stripeRefundId": {
            "type": "string",
            "nullable": true
          },
          "stripeRefundStatus": {
            "type": "string",
            "nullable": true
          },
          "refundRequestedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastStripeSyncAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "saleId",
          "method",
          "type",
          "amount",
          "status",
          "externalReference",
          "stripeIntentId",
          "stripeStatus",
          "stripeRefundId",
          "stripeRefundStatus",
          "refundRequestedAt",
          "lastStripeSyncAt",
          "paidAt"
        ]
      },
      "PaymentStatus": {
        "type": "object",
        "properties": {
          "saleId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "saleStatus": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Payment"
            }
          }
        },
        "required": [
          "saleId",
          "saleStatus",
          "expiresAt",
          "payments"
        ]
      },
      "WebhookResult": {
        "type": "object",
        "properties": {
          "received": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "ignored": {
            "type": "boolean"
          }
        },
        "required": [
          "received"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "statusCode": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "path": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "success",
          "statusCode",
          "error",
          "message",
          "path",
          "timestamp"
        ]
      }
    }
  }
}
