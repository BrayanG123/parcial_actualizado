generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  /// Administrador de la plataforma SaaS: no pertenece a ninguna empresa.
  PLATFORM_ADMIN
  ADMINISTRATOR
  BRANCH_MANAGER
  CASHIER
  CUSTOMER
  SUPPLIER
}

enum InventoryMovementType {
  ENTRY
  SALE
  RESERVATION
  RESERVATION_RELEASE
  RETURN
  ADJUSTMENT
  PENDING_ENTRY
  CHECKOUT_HOLD
  CHECKOUT_RELEASE
}

enum InventoryMovementStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  PREPARING
  READY
  CUSTOMER_PRESENT
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ReservationItemStatus {
  PENDING
  PREPARED
  PURCHASED
  RETURNED
  UNAVAILABLE
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum SaleChannel {
  IN_STORE
  WEB
  MOBILE
}

enum SaleStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  QR
  BANK_TRANSFER
  GATEWAY
}

enum PaymentType {
  IN_STORE
  ELECTRONIC
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
  REFUNDED
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum SubscriptionAction {
  ASSIGN
  CHANGE_PLAN
  RENEW
  SUSPEND
  REACTIVATE
  CANCEL
  EXPIRE
}

/// Empresa contratante (tenant). Una sucursal NO es un tenant.
model Tenant {
  id                 Int                 @id @default(autoincrement()) @map("id_empresa")
  name               String              @map("nombre") @db.VarChar(150)
  /// Codigo publico de la empresa en URLs y en el header X-Tenant.
  slug               String              @unique @db.VarChar(60)
  status             TenantStatus        @default(ACTIVE) @map("estado")
  createdAt          DateTime            @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  subscription       Subscription?
  users              User[]
  clients            Client[]
  employees          Employee[]
  branches           Branch[]
  categories         Category[]
  seasons            Season[]
  collections        Collection[]
  suppliers          Supplier[]
  sizes              Size[]
  colors             Color[]
  products           Product[]
  productSizes       ProductSize[]
  productColors      ProductColor[]
  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  reservations       Reservation[]
  reservationItems   ReservationItem[]
  carts              Cart[]
  cartItems          CartItem[]
  cashRegisters      CashRegister[]
  cashShifts         CashShift[]
  offlineBatches     OfflineBatch[]
  sales              Sale[]
  saleItems          SaleItem[]
  payments           Payment[]
  arResources        ArResource[]
  aiRecommendations  AiRecommendation[]
  notifications      Notification[]
  pushTokens         PushToken[]
  syncOperations     SyncOperation[]
  syncLogs           SyncLog[]

  @@map("empresas")
}

/// Plan configurable desde la base: limites y funcionalidades no estan en el codigo.
model Plan {
  id                Int                   @id @default(autoincrement()) @map("id_plan")
  code              String                @unique @map("codigo") @db.VarChar(40)
  name              String                @map("nombre") @db.VarChar(80)
  description       String?               @map("descripcion") @db.VarChar(250)
  maxActiveBranches Int                   @map("max_sucursales_activas")
  /// Banderas de funcionalidad, p. ej. { "aiReports": true, "offline": true }.
  features          Json                  @default("{}") @map("funcionalidades")
  monthlyPrice      Decimal               @default(0) @map("precio_mensual") @db.Decimal(12, 2)
  active            Boolean               @default(true) @map("activo")
  createdAt         DateTime              @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  subscriptions     Subscription[]
  historyFrom       SubscriptionHistory[] @relation("HistoryFromPlan")
  historyTo         SubscriptionHistory[] @relation("HistoryToPlan")

  @@map("planes")
}

/// Suscripcion vigente de una empresa (una por empresa); los cambios quedan en el historial.
model Subscription {
  id        Int                   @id @default(autoincrement()) @map("id_suscripcion")
  tenantId  Int                   @unique @map("id_empresa")
  planId    Int                   @map("id_plan")
  startsAt  DateTime              @map("fecha_inicio") @db.Timestamptz(3)
  endsAt    DateTime              @map("fecha_vencimiento") @db.Timestamptz(3)
  status    SubscriptionStatus    @default(ACTIVE) @map("estado")
  createdAt DateTime              @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt DateTime              @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan      Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  history   SubscriptionHistory[]

  @@index([planId])
  @@index([status, endsAt])
  @@map("suscripciones")
}

model SubscriptionHistory {
  id             Int                @id @default(autoincrement()) @map("id_historial")
  subscriptionId Int                @map("id_suscripcion")
  action         SubscriptionAction @map("accion")
  fromPlanId     Int?               @map("id_plan_anterior")
  toPlanId       Int                @map("id_plan_nuevo")
  status         SubscriptionStatus @map("estado")
  startsAt       DateTime           @map("fecha_inicio") @db.Timestamptz(3)
  endsAt         DateTime           @map("fecha_vencimiento") @db.Timestamptz(3)
  note           String?            @map("observacion") @db.VarChar(250)
  performedById  Int?               @map("id_usuario")
  createdAt      DateTime           @default(now()) @map("fecha") @db.Timestamptz(3)
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromPlan       Plan?              @relation("HistoryFromPlan", fields: [fromPlanId], references: [id], onDelete: Restrict)
  toPlan         Plan               @relation("HistoryToPlan", fields: [toPlanId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, createdAt])
  @@map("historial_suscripciones")
}

model User {
  /// Empresa (tenant) propietaria; null solo para PLATFORM_ADMIN.
  tenantId          Int?               @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplierId        Int?               @map("id_proveedor")
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  id                Int                @id @default(autoincrement()) @map("id_usuario")
  name              String             @map("nombre") @db.VarChar(120)
  email             String             @db.VarChar(180)
  passwordHash      String             @map("password_hash")
  active            Boolean            @default(true) @map("activo")
  registeredAt      DateTime           @default(now()) @map("fecha_registro") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  client            Client?
  employee          Employee?
  roles             UserRole[]
  createdSales      Sale[]             @relation("SaleCreator")
  cashShifts        CashShift[]
  notificationReads NotificationRead[]
  pushTokens        PushToken[]

  // Email unico por empresa. Para PLATFORM_ADMIN (sin empresa) un indice parcial
  // de la migracion 20261027000000_multitenancy evita emails repetidos.
  @@unique([tenantId, email])
  @@index([supplierId])
  @@index([tenantId])
  @@map("usuarios")
}

model Client {
  /// Empresa (tenant) propietaria.
  tenantId        Int                @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  wholesale       Boolean            @default(false) @map("mayorista")
  id              Int                @id @default(autoincrement()) @map("id_cliente")
  userId          Int                @unique @map("id_usuario")
  phone           String?            @map("telefono") @db.VarChar(30)
  address         String?            @map("direccion") @db.VarChar(250)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations    Reservation[]
  carts           Cart[]
  sales           Sale[]
  recommendations AiRecommendation[]

  @@index([tenantId])
  @@map("clientes")
}

model Employee {
  /// Empresa (tenant) propietaria.
  tenantId           Int                 @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id                 Int                 @id @default(autoincrement()) @map("id_empleado")
  userId             Int                 @unique @map("id_usuario")
  branchId           Int                 @map("id_sucursal")
  jobTitle           String              @map("cargo") @db.VarChar(80)
  active             Boolean             @default(true) @map("activo")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]
  sales              Sale[]

  @@index([branchId])
  @@index([tenantId])
  @@map("empleados")
}

model Role {
  id          Int        @id @default(autoincrement()) @map("id_rol")
  name        RoleName   @unique @map("nombre")
  description String?    @map("descripcion") @db.VarChar(250)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     Int      @map("id_usuario")
  roleId     Int      @map("id_rol")
  assignedAt DateTime @default(now()) @map("fecha_asignacion") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("usuarios_roles")
}

model Branch {
  /// Empresa (tenant) propietaria.
  tenantId      Int            @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// MVP: un solo almacen por sucursal; comparte su identificador y existencias.
  warehouseName String         @default("Almacen principal") @map("nombre_almacen") @db.VarChar(120)
  id            Int            @id @default(autoincrement()) @map("id_sucursal")
  name          String         @map("nombre") @db.VarChar(120)
  city          String         @map("ciudad") @db.VarChar(100)
  address       String         @map("direccion") @db.VarChar(250)
  phone         String?        @map("telefono") @db.VarChar(30)
  active        Boolean        @default(true) @map("activa")
  employees     Employee[]
  inventory     Inventory[]
  reservations  Reservation[]
  sales         Sale[]
  notifications Notification[]
  cashRegisters CashRegister[]

  @@unique([tenantId, city, name])
  @@index([city, active])
  @@index([tenantId])
  @@map("sucursales")
}

model Category {
  /// Empresa (tenant) propietaria.
  tenantId    Int       @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id          Int       @id @default(autoincrement()) @map("id_categoria")
  name        String    @map("nombre") @db.VarChar(100)
  description String?   @map("descripcion") @db.VarChar(250)
  products    Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categorias")
}

model Season {
  /// Empresa (tenant) propietaria.
  tenantId    Int          @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id          Int          @id @default(autoincrement()) @map("id_temporada")
  name        String       @map("nombre") @db.VarChar(120)
  startDate   DateTime     @map("fecha_inicio") @db.Date
  endDate     DateTime     @map("fecha_fin") @db.Date
  active      Boolean      @default(true) @map("activa")
  collections Collection[]
  products    Product[]

  @@unique([tenantId, name])
  @@index([active, startDate, endDate])
  @@index([tenantId])
  @@map("temporadas")
}

model Collection {
  /// Empresa (tenant) propietaria.
  tenantId    Int       @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id          Int       @id @default(autoincrement()) @map("id_coleccion")
  seasonId    Int       @map("id_temporada")
  name        String    @map("nombre") @db.VarChar(120)
  description String?   @map("descripcion") @db.VarChar(250)
  active      Boolean   @default(true) @map("activa")
  season      Season    @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([seasonId, name])
  @@index([active])
  @@index([tenantId])
  @@map("colecciones")
}

model Supplier {
  /// Empresa (tenant) propietaria.
  tenantId Int       @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accounts User[]
  id       Int       @id @default(autoincrement()) @map("id_proveedor")
  name     String    @map("nombre") @db.VarChar(150)
  contact  String?   @map("contacto") @db.VarChar(120)
  phone    String?   @map("telefono") @db.VarChar(30)
  email    String?   @db.VarChar(180)
  active   Boolean   @default(true) @map("activo")
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("proveedores")
}

model Size {
  /// Empresa (tenant) propietaria.
  tenantId         Int               @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id               Int               @id @default(autoincrement()) @map("id_talla")
  name             String            @map("nombre") @db.VarChar(30)
  products         ProductSize[]
  inventory        Inventory[]
  reservationItems ReservationItem[]
  cartItems        CartItem[]
  saleItems        SaleItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tallas")
}

model Color {
  /// Empresa (tenant) propietaria.
  tenantId         Int               @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id               Int               @id @default(autoincrement()) @map("id_color")
  name             String            @map("nombre") @db.VarChar(60)
  hexCode          String            @map("codigo_hex") @db.VarChar(7)
  products         ProductColor[]
  inventory        Inventory[]
  reservationItems ReservationItem[]
  cartItems        CartItem[]
  saleItems        SaleItem[]

  @@unique([tenantId, name])
  @@unique([tenantId, hexCode])
  @@index([tenantId])
  @@map("colores")
}

model Product {
  /// Empresa (tenant) propietaria.
  tenantId             Int                @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplierAvailability String?            @map("disponibilidad_proveedor") @db.VarChar(500)
  wholesalePrice       Decimal?           @map("precio_mayorista") @db.Decimal(12, 2)
  imageUrls            String[]           @default([]) @map("imagenes")
  id                   Int                @id @default(autoincrement()) @map("id_producto")
  categoryId           Int                @map("id_categoria")
  seasonId             Int                @map("id_temporada")
  collectionId         Int                @map("id_coleccion")
  supplierId           Int                @map("id_proveedor")
  name                 String             @map("nombre") @db.VarChar(160)
  description          String?            @map("descripcion") @db.Text
  price                Decimal            @map("precio") @db.Decimal(12, 2)
  imageUrl             String?            @map("imagen_url") @db.Text
  discountPercent      Decimal            @default(0) @map("descuento_pct") @db.Decimal(5, 2)
  promotionStart       DateTime?          @map("promo_inicio") @db.Date
  promotionEnd         DateTime?          @map("promo_fin") @db.Date
  active               Boolean            @default(true) @map("activo")
  createdAt            DateTime           @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  category             Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  season               Season             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  collection           Collection         @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  supplier             Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sizes                ProductSize[]
  colors               ProductColor[]
  inventory            Inventory[]
  reservationItems     ReservationItem[]
  cartItems            CartItem[]
  saleItems            SaleItem[]
  arResources          ArResource[]
  recommendations      AiRecommendation[]

  @@unique([supplierId, name])
  @@index([categoryId, active])
  @@index([tenantId, active])
  @@index([seasonId, collectionId])
  @@index([supplierId])
  @@index([name])
  @@index([tenantId])
  @@map("productos")
}

model ProductSize {
  /// Empresa (tenant) propietaria.
  tenantId  Int     @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productId Int     @map("id_producto")
  sizeId    Int     @map("id_talla")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      Size    @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@id([productId, sizeId])
  @@index([sizeId])
  @@index([tenantId])
  @@map("productos_tallas")
}

model ProductColor {
  /// Empresa (tenant) propietaria.
  tenantId  Int     @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productId Int     @map("id_producto")
  colorId   Int     @map("id_color")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@id([productId, colorId])
  @@index([colorId])
  @@index([tenantId])
  @@map("productos_colores")
}

model Inventory {
  /// Empresa (tenant) propietaria.
  tenantId         Int                 @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id               Int                 @id @default(autoincrement()) @map("id_inventario")
  branchId         Int                 @map("id_sucursal")
  productId        Int                 @map("id_producto")
  sizeId           Int                 @map("id_talla")
  colorId          Int                 @map("id_color")
  physicalQuantity Int                 @default(0) @map("cantidad_fisica")
  reservedQuantity Int                 @default(0) @map("cantidad_reservada")
  updatedAt        DateTime            @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  size             Size                @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  color            Color               @relation(fields: [colorId], references: [id], onDelete: Restrict)
  movements        InventoryMovement[]

  @@unique([branchId, productId, sizeId, colorId])
  @@index([productId, sizeId, colorId])
  @@index([tenantId])
  @@map("inventarios")
}

model InventoryMovement {
  /// Empresa (tenant) propietaria.
  tenantId    Int                     @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id          Int                     @id @default(autoincrement()) @map("id_movimiento")
  inventoryId Int                     @map("id_inventario")
  employeeId  Int?                    @map("id_empleado")
  type        InventoryMovementType   @map("tipo")
  quantity    Int                     @map("cantidad")
  status      InventoryMovementStatus @default(COMPLETED) @map("estado")
  reference   String?                 @map("referencia") @db.VarChar(150)
  occurredAt  DateTime                @default(now()) @map("fecha") @db.Timestamptz(3)
  scheduledAt DateTime?               @map("fecha_programada") @db.Timestamptz(3)
  observation String?                 @map("observacion") @db.VarChar(500)
  inventory   Inventory               @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  employee    Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([inventoryId, occurredAt])
  @@index([employeeId])
  @@index([type, status])
  @@index([tenantId])
  @@map("movimientos_inventario")
}

model Reservation {
  /// Empresa (tenant) propietaria.
  tenantId        Int               @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id              Int               @id @default(autoincrement()) @map("id_reserva")
  clientId        Int               @map("id_cliente")
  branchId        Int               @map("id_sucursal")
  reservedAt      DateTime          @default(now()) @map("fecha_reserva") @db.Timestamptz(3)
  approximateTime DateTime          @map("horario_aproximado") @db.Timestamptz(3)
  expiresAt       DateTime          @map("fecha_vencimiento") @db.Timestamptz(3)
  status          ReservationStatus @default(PENDING) @map("estado")
  /// operationId de la reserva registrada offline (idempotencia de /sync/operations).
  operationKey    String?           @map("clave_operacion") @db.Uuid
  observation     String?           @map("observacion") @db.VarChar(500)
  updatedAt       DateTime          @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items           ReservationItem[]
  sale            Sale?
  notification    Notification?

  @@unique([tenantId, operationKey])
  @@index([clientId, status])
  @@index([branchId, approximateTime, status])
  @@index([status, expiresAt])
  @@index([tenantId])
  @@map("reservas")
}

model ReservationItem {
  /// Empresa (tenant) propietaria.
  tenantId          Int                   @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id                Int                   @id @default(autoincrement()) @map("id_detalle_reserva")
  reservationId     Int                   @map("id_reserva")
  productId         Int                   @map("id_producto")
  sizeId            Int                   @map("id_talla")
  colorId           Int                   @map("id_color")
  quantity          Int                   @map("cantidad")
  purchasedQuantity Int                   @default(0) @map("cantidad_comprada")
  status            ReservationItemStatus @default(PENDING) @map("estado")
  reservation       Reservation           @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product           Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  size              Size                  @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  color             Color                 @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@unique([reservationId, productId, sizeId, colorId])
  @@index([productId, sizeId, colorId])
  @@index([tenantId])
  @@map("detalles_reserva")
}

model Cart {
