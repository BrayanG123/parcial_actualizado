{
  "openapi": "3.0.3",
  "info": {
    "title": "FashionStore — Reportes",
    "version": "1.0.0",
    "description": "Administrador global; encargado limitado a su sucursal. Fechas inclusivas en Bolivia, máximo 366 días; 30 días por defecto. Inventario actual sin filtro histórico. Importes separados por moneda."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/reports/sales": {
      "get": {
        "summary": "Ventas completadas por moneda, sucursal, canal y día",
        "operationId": "reportSales",
        "parameters": [
          {
            "name": "branchId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "IN_STORE",
                "WEB",
                "MOBILE"
              ]
            }
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reporte calculado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Sales"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Filtros o periodo inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rol insuficiente o sucursal ajena",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/reports/top-products": {
      "get": {
        "summary": "Productos por unidades vendidas; límite por moneda",
        "operationId": "reportTopProducts",
        "parameters": [
          {
            "name": "branchId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "IN_STORE",
                "WEB",
                "MOBILE"
              ]
            }
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reporte calculado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/TopProducts"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Filtros o periodo inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rol insuficiente o sucursal ajena",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/reports/inventory": {
      "get": {
        "summary": "Stock actual, entradas pendientes y stock bajo",
        "operationId": "reportInventory",
        "parameters": [
          {
            "name": "branchId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          {
            "name": "productId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          {
            "name": "lowStockOnly",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            }
          },
          {
            "name": "lowStockThreshold",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 5
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reporte calculado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Inventory"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Filtros o periodo inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rol insuficiente o sucursal ajena",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/reports/reservations": {
      "get": {
        "summary": "Reservas por sucursal y estado según la fecha de cita",
        "operationId": "reportReservations",
        "parameters": [
          {
            "name": "branchId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reporte calculado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Reservations"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Filtros o periodo inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rol insuficiente o sucursal ajena",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Period": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "endExclusive": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "from",
          "to",
          "timeZone",
          "start",
          "endExclusive"
        ]
      },
      "Metrics": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "saleCount": {
            "type": "integer"
          },
          "unitsSold": {
            "type": "number"
          },
          "revenue": {
            "type": "number"
          },
          "averageTicket": {
            "type": "number"
          }
        },
        "required": [
          "currency",
          "saleCount",
          "unitsSold",
          "revenue",
          "averageTicket"
        ]
      },
      "BranchMetrics": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Metrics"
          },
          {
            "type": "object",
            "properties": {
              "branchId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647,
                "nullable": true
              },
              "branchName": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "branchId",
              "branchName"
            ]
          }
        ]
      },
      "ChannelMetrics": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Metrics"
          },
          {
            "type": "object",
            "properties": {
              "channel": {
                "type": "string"
              }
            },
            "required": [
              "channel"
            ]
          }
        ]
      },
      "DailyMetrics": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Metrics"
          },
          {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "date"
            ]
          }
        ]
      },
      "Sales": {
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/Period"
          },
          "filters": {
            "type": "object"
          },
          "totals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Metrics"
            }
          },
          "byBranch": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BranchMetrics"
            }
          },
          "byChannel": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChannelMetrics"
            }
          },
          "daily": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyMetrics"
            }
          }
        },
        "required": [
          "period",
          "filters",
          "totals",
          "byBranch",
          "byChannel",
          "daily"
        ]
      },
      "ProductRank": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "productName": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "unitsSold": {
            "type": "number"
          },
          "saleCount": {
            "type": "integer"
          },
          "revenue": {
            "type": "number"
          },
          "rank": {
            "type": "integer"
          }
        },
        "required": [
          "productId",
          "productName",
          "currency",
          "unitsSold",
          "saleCount",
          "revenue",
          "rank"
        ]
      },
      "TopProducts": {
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/Period"
          },
          "filters": {
            "type": "object"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductRank"
            }
          }
        },
        "required": [
          "period",
          "filters",
          "items"
        ]
      },
      "StockSummary": {
        "type": "object",
        "properties": {
          "variantCount": {
            "type": "integer"
          },
          "physical": {
            "type": "number"
          },
          "reserved": {
            "type": "number"
          },
          "available": {
            "type": "number"
          },
          "incoming": {
            "type": "number"
          },
          "lowStockCount": {
            "type": "integer"
          },
          "outOfStockCount": {
            "type": "integer"
          }
        },
        "required": [
          "variantCount",
          "physical",
          "reserved",
          "available",
          "incoming",
          "lowStockCount",
          "outOfStockCount"
        ]
      },
      "StockBranch": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StockSummary"
          },
          {
            "type": "object",
            "properties": {
              "branchId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "branchName": {
                "type": "string"
              }
            },
            "required": [
              "branchId",
              "branchName"
            ]
          }
        ]
      },
      "StockItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "branchId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "branchName": {
            "type": "string"
          },
          "branchActive": {
            "type": "boolean"
          },
          "productId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "productName": {
            "type": "string"
          },
          "productActive": {
            "type": "boolean"
          },
          "sizeId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "sizeName": {
            "type": "string"
          },
          "colorId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "colorName": {
            "type": "string"
          },
          "physical": {
            "type": "integer"
          },
          "reserved": {
            "type": "integer"
          },
          "available": {
            "type": "integer"
          },
          "incoming": {
            "type": "number"
          },
          "lowStock": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "branchId",
          "branchName",
          "branchActive",
          "productId",
          "productName",
          "productActive",
          "sizeId",
          "sizeName",
          "colorId",
          "colorName",
          "physical",
          "reserved",
          "available",
          "incoming",
          "lowStock"
        ]
      },
      "Inventory": {
        "type": "object",
        "properties": {
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "filters": {
            "type": "object"
          },
          "summary": {
            "$ref": "#/components/schemas/StockSummary"
          },
          "byBranch": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockBranch"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockItem"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "totalPages": {
                "type": "integer"
              }
            },
            "required": [
              "page",
              "limit",
              "total",
              "totalPages"
            ]
          }
        },
        "required": [
          "generatedAt",
          "filters",
          "summary",
          "byBranch",
          "items",
          "meta"
        ]
      },
      "ReservationCount": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "branchName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "branchId",
          "branchName",
          "status",
          "count"
        ]
      },
      "Reservations": {
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/Period"
          },
          "filters": {
            "type": "object"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReservationCount"
            }
          }
        },
        "required": [
          "period",
          "filters",
          "items"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "statusCode": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "path": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "statusCode",
          "error",
          "message",
          "path",
          "timestamp"
        ]
      }
    }
  }
}
