model NotificationRead {
  notificationId Int          @map("id_notificacion")
  userId         Int          @map("id_usuario")
  readAt         DateTime     @default(now()) @map("fecha_lectura") @db.Timestamptz(3)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, notificationId])
  @@map("lecturas_notificacion")
}

enum SyncOperationType {
  SALE_CASH
  RESERVATION
  EXCHANGE
}

/// Estado en el servidor. LOCAL, SENDING y RETRY existen solo en los clientes.
enum SyncOperationStatus {
  PROCESSING
  CONFIRMED
  REJECTED
  CONFLICT
}

/// Operacion registrada offline (web o movil) y su resultado; operationId es la clave
/// de idempotencia por empresa (RNF05).
model SyncOperation {
  id             Int                 @id @default(autoincrement()) @map("id_operacion_sync")
  tenantId       Int                 @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  operationId    String              @map("id_operacion") @db.Uuid
  deviceId       String              @map("id_dispositivo") @db.Uuid
  userId         Int                 @map("id_usuario")
  branchId       Int?                @map("id_sucursal")
  type           SyncOperationType   @map("tipo")
  status         SyncOperationStatus @map("estado")
  payload        Json                @map("datos")
  payloadHash    String              @map("hash_datos") @db.VarChar(64)
  createdAtLocal DateTime            @map("fecha_local") @db.Timestamptz(3)
  receivedAt     DateTime            @default(now()) @map("fecha_recepcion") @db.Timestamptz(3)
  processedAt    DateTime?           @map("fecha_proceso") @db.Timestamptz(3)
  attempts       Int                 @default(0) @map("intentos")
  resultCode     String?             @map("codigo_resultado") @db.VarChar(60)
  resultMessage  String?             @map("mensaje_resultado") @db.VarChar(500)
  resultDetail   Json?               @map("detalle_resultado")
  resourceType   String?             @map("tipo_recurso") @db.VarChar(30)
  resourceId     Int?                @map("id_recurso")
  logs           SyncLog[]

  @@unique([tenantId, operationId])
  @@index([tenantId, userId, deviceId])
  @@index([tenantId, status, receivedAt])
  @@map("operaciones_sync")
}

/// Bitacora de cada intento de sincronizacion (RNF10): sin datos personales ni payload.
model SyncLog {
  id              Int                 @id @default(autoincrement()) @map("id_log_sync")
  tenantId        Int                 @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  syncOperationId Int                 @map("id_operacion_sync")
  syncOperation   SyncOperation       @relation(fields: [syncOperationId], references: [id], onDelete: Cascade)
  attempt         Int                 @map("intento")
  status          SyncOperationStatus @map("estado")
  errorCode       String?             @map("codigo_error") @db.VarChar(60)
  latencyMs       Int                 @map("latencia_ms")
  createdAt       DateTime            @default(now()) @map("fecha") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([syncOperationId])
  @@map("sync_log")
}
