# API NestJS desplegada en Azure (incluye el prefijo /api/v1).
# Funciona desde cualquier red: no hace falta que el telefono y la computadora
# esten en la misma Wi-Fi.
EXPO_PUBLIC_API_URL=https://fashionstore-backend.thankfulrock-c0942cba.eastus.azurecontainerapps.io/api/v1
# Para trabajar contra el backend local usa la IP de la computadora en la red
# (localhost solo sirve en la vista web):
# EXPO_PUBLIC_API_URL=http://192.168.100.140:3000/api/v1
# true usa el backend simulado local (demo sin NestJS).
EXPO_PUBLIC_USE_MOCKS=false
# Web de la plataforma (landing SaaS). Opcional: habilita "Registrala en la web" en el primer arranque.
# EXPO_PUBLIC_WEB_URL=http://192.168.100.140:8080
