# Variables de docker-compose.yml (copiar a .env en la raiz).
# Las claves de la API (JWT, Stripe, Gemini...) van en backend/.env.
POSTGRES_DB=tienda_ropa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_PORT=5433

API_PORT=3000
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
# Relativa: nginx del frontend reenvia /api al backend.
PUBLIC_API_URL=/api/v1

# IA local: con el perfil ia-local el backend usa el contenedor ollama
# (definir AI_PROVIDER=ollama en backend/.env).
OLLAMA_BASE_URL=http://ollama:11434
