                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos o fecha inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso sobre la reserva o sucursal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Reserva inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Sin stock, transición inválida, reserva cerrada o conflicto concurrente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/reservations/{id}/cancel": {
      "patch": {
        "summary": "Cancelar y liberar stock",
        "description": "Propietario antes de CUSTOMER_PRESENT; administrador o encargado de la sucursal para cualquier estado abierto. Repetir CANCELLED es idempotente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "timestamp"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Reservation"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos o fecha inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso sobre la reserva o sucursal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Reserva inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Sin stock, transición inválida, reserva cerrada o conflicto concurrente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/reservations/{id}/status": {
      "patch": {
        "summary": "Cambiar estado (ADMINISTRATOR o BRANCH_MANAGER)",
        "description": "PENDING → PREPARING → READY → CUSTOMER_PRESENT → COMPLETED. CANCELLED permitido desde estados abiertos. EXPIRED es automático. Repetir el estado actual es idempotente salvo reserva vencida.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "PREPARING",
                      "READY",
                      "CUSTOMER_PRESENT",
                      "COMPLETED",
                      "CANCELLED"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "timestamp"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Reservation"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos o fecha inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso sobre la reserva o sucursal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Reserva inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Sin stock, transición inválida, reserva cerrada o conflicto concurrente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ReservationItemInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "sizeId", "colorId", "quantity"],
        "properties": {
          "productId": {
            "type": "integer",
            "minimum": 1
          },
          "sizeId": {
            "type": "integer",
            "minimum": 1
          },
          "colorId": {
            "type": "integer",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "CreateReservation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branchId", "approximateTime", "items"],
        "properties": {
          "branchId": {
            "type": "integer",
            "minimum": 1
          },
          "approximateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha futura con hora y zona explícita; ejemplo 2030-09-11T15:00:00-04:00"
          },
          "observation": {
            "type": "string",
            "maxLength": 500
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "description": "Combinaciones producto/talla/color sin duplicados",
            "items": {
              "$ref": "#/components/schemas/ReservationItemInput"
            }
          }
        }
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "clientId": {
            "type": "integer"
          },
          "branchId": {
            "type": "integer"
          },
          "reservedAt": {
            "type": "string",
            "format": "date-time"
          },
          "approximateTime": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PREPARING",
              "READY",
              "CUSTOMER_PRESENT",
              "COMPLETED",
              "CANCELLED",
              "EXPIRED"
            ]
          },
          "observation": {
            "type": "string",
            "nullable": true
          },
          "branch": {
            "type": "object",
            "description": "id, name, city, address"
          },
          "client": {
            "type": "object",
            "description": "id, userId, phone y user {name, email}; no incluye contraseñas"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "id, reservationId, productId, sizeId, colorId, quantity, status, product {id, name, imageUrl}, size y color"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [false]
          },
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "error": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
