model Sale {
  /// Empresa (tenant) propietaria.
  tenantId           Int           @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer")) @map("id_empresa")
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  cashOnDelivery     Boolean       @default(false) @map("contra_entrega")
  deliveryName       String?       @map("destinatario") @db.VarChar(120)
  deliveryPhone      String?       @map("telefono_entrega") @db.VarChar(30)
  deliveryAddress    String?       @map("direccion_entrega") @db.VarChar(250)
  deliveredAt        DateTime?     @map("fecha_entrega") @db.Timestamptz(3)
  offlineBatchId     String?       @map("id_lote_offline") @db.Uuid
  offlineBatch       OfflineBatch? @relation(fields: [offlineBatchId], references: [id], onDelete: Restrict)
  shiftId            Int?          @map("id_turno")
  shift              CashShift?    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  id                 Int           @id @default(autoincrement()) @map("id_venta")
  clientId           Int?          @map("id_cliente")
  employeeId         Int?          @map("id_empleado")
  branchId           Int?          @map("id_sucursal")
  reservationId      Int?          @unique @map("id_reserva")
  cartId             Int?          @unique @map("id_carrito")
  createdById        Int?          @map("id_usuario_creador")
  idempotencyKey     String?       @map("clave_idempotencia") @db.Uuid
  requestHash        String?       @map("hash_solicitud") @db.VarChar(64)
  currency           String        @default("BOB") @map("moneda") @db.VarChar(3)
  stockReserved      Boolean       @default(false) @map("stock_apartado")
  expiresAt          DateTime?     @map("fecha_vencimiento") @db.Timestamptz(3)
  confirmedAt        DateTime?     @map("fecha_confirmacion") @db.Timestamptz(3)
  cancellationReason String?       @map("motivo_cancelacion") @db.VarChar(100)
  soldAt             DateTime      @default(now()) @map("fecha") @db.Timestamptz(3)
  channel            SaleChannel   @map("canal")
  status             SaleStatus    @default(DRAFT) @map("estado")
  total              Decimal       @db.Decimal(12, 2)
  updatedAt          DateTime      @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  client             Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  employee           Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  branch             Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reservation        Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  cart               Cart?         @relation(fields: [cartId], references: [id], onDelete: SetNull)
  createdBy          User?         @relation("SaleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items              SaleItem[]
  payments           Payment[]

  @@unique([createdById, idempotencyKey])
  @@index([offlineBatchId])
  @@index([shiftId])
  @@index([clientId, soldAt])
  @@index([employeeId])
  @@index([branchId, soldAt])
  @@index([tenantId, soldAt])
  @@index([channel, status])
  @@index([status, expiresAt])
  @@index([tenantId])
  @@map("ventas")
}

