  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "SaleItemInput": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "sizeId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "colorId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "productId",
          "sizeId",
          "colorId",
          "quantity"
        ]
      },
      "InStoreSale": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid",
            "description": "UUID v4; reutilizar en reintentos idénticos."
          },
          "branchId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "clientId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "reservationId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/SaleItemInput"
            }
          },
          "expectedTotal": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 9999999999.99,
            "multipleOf": 0.01
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "CASH",
              "CARD",
              "QR",
              "BANK_TRANSFER"
            ]
          },
          "paymentReference": {
            "type": "string",
            "maxLength": 175,
            "description": "Obligatoria y no vacía para métodos distintos de CASH; pago ya recibido externamente."
          }
        },
        "required": [
          "idempotencyKey",
          "branchId",
          "items",
          "expectedTotal",
          "paymentMethod"
        ]
      },
      "CheckoutPreviewInput": {
        "type": "object",
        "properties": {
          "cartId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "branchId": {
            "type": "integer",
            "minimum": 1,
